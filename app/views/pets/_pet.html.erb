<div id="<%= dom_id pet %>">
  <p>
    <strong>Name:</strong>
    <%= pet.name %>
  </p>

  <p>
    <strong>Species:</strong>
    <%= pet.species %>
  </p>

  <p>
    <strong>Breed:</strong>
    <%= pet.breed %>
  </p>

  <p>
    <strong>Birthdate:</strong>
    <%= pet.birthdate %>
  </p>

  <p>
    <strong>Customer:</strong>
    <%= pet.customer_id %>
  </p>

</div>
